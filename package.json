{
  "name": "wdio-test-runner-ui",
  "version": "1.0.0",
  "description": "UI Test Runner for WebdriverIO",
  "main": "dist/index.js",
  "bin": {
    "wdio-test-runner-ui": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc && cp -r src/views dist/ && cp -r src/public dist/",
    "dev": "nodemon --exec ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@wdio/cli": "^8.20.2",
    "@wdio/globals": "^8.20.2",
    "@wdio/local-runner": "^8.20.2",
    "@wdio/mocha-framework": "^8.20.2",
    "@wdio/spec-reporter": "^8.20.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "ejs": "^3.1.9",
    "glob": "^10.3.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "webdriverio": "^8.20.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.4.5",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "test",
    "testing",
    "ui",
    "runner"
  ],
  "author": "",
  "license": "MIT"
} 