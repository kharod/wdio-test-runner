<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WebdriverIO Test Runner</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">
        <i class="bi bi-speedometer2 me-2"></i>
        WebdriverIO Test Runner
      </a>
    </div>
  </nav>

  <div class="container-fluid">
    <div class="row">
      <!-- Sidebar with test files -->
      <div class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
        <div class="position-sticky pt-3">
          <h6 class="sidebar-heading d-flex justify-content-between align-items-center px-3 mt-4 mb-1 text-muted">
            <span>Test Files</span>
            <button id="refresh-tests" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-arrow-clockwise"></i>
            </button>
          </h6>
          <ul class="nav flex-column" id="test-files-list">
            <% if (testFiles && testFiles.length > 0) { %>
              <% testFiles.forEach(function(file) { %>
                <li class="nav-item test-file" data-file="<%= file.filePath %>">
                  <a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-code me-2"></i>
                    <%= file.relativePath %>
                  </a>
                  <% if (file.specs && file.specs.length > 0) { %>
                    <ul class="specs-list d-none">
                      <% file.specs.forEach(function(spec) { %>
                        <li class="spec-item" data-spec="<%= spec %>">
                          <a href="#"><i class="bi bi-play-circle me-1"></i><%= spec %></a>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </li>
              <% }); %>
            <% } else { %>
              <li class="nav-item">
                <span class="nav-link text-muted">No test files found</span>
              </li>
            <% } %>
          </ul>
          
          <!-- Test Summary Section -->
          <div class="test-summary-container mt-4 px-3">
            <h6 class="sidebar-heading d-flex justify-content-between align-items-center mb-2 text-muted">
              <span>Test Summary</span>
            </h6>
            <div id="test-summary" class="card">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="badge rounded-pill bg-success px-3 py-2" id="tests-passed">0 Passed</span>
                  <span class="badge rounded-pill bg-danger px-3 py-2" id="tests-failed">0 Failed</span>
                </div>
                <div class="progress mb-2" style="height: 10px;">
                  <div id="pass-progress" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                  <div id="fail-progress" class="progress-bar bg-danger" role="progressbar" style="width: 0%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                  <span id="test-duration">Duration: 0s</span>
                  <span id="test-count">Total: 0</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main content area -->
      <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
        <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-4 pb-2 mb-3 border-bottom">
          <h1 class="h2">Test Runner</h1>
          <div class="btn-toolbar mb-2 mb-md-0">
            <div class="form-check form-switch me-3">
              <input class="form-check-input" type="checkbox" id="headless-mode-toggle" checked>
              <label class="form-check-label" for="headless-mode-toggle">Headless Mode</label>
            </div>
            <div class="btn-group me-2">
              <button id="run-all-tests" class="btn btn-sm btn-primary">
                <i class="bi bi-play-fill me-1"></i>Run All Tests
              </button>
              <button id="stop-tests" class="btn btn-sm btn-danger" disabled>
                <i class="bi bi-stop-fill me-1"></i>Stop
              </button>
            </div>
          </div>
        </div>

        <!-- Current test info -->
        <div id="current-test-info" class="alert alert-info d-none">
          <div class="d-flex align-items-center">
            <i class="bi bi-file-earmark-code me-2 fs-4"></i>
            <div>
              <h5 id="current-test-file" class="mb-1">No test selected</h5>
              <p id="current-test-spec" class="mb-0 small"></p>
            </div>
          </div>
        </div>

        <!-- Test results -->
        <div class="card mb-4 shadow-sm">
          <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <h5 class="mb-0">
              <i class="bi bi-terminal me-2"></i>
              Test Output
            </h5>
            <button id="clear-output" class="btn btn-sm btn-outline-secondary">
              <i class="bi bi-trash me-1"></i>Clear
            </button>
          </div>
          <div class="card-body">
            <div id="test-output" class="overflow-auto p-3 bg-dark text-light rounded" style="max-height: 500px;"></div>
          </div>
        </div>

        <!-- Status bar -->
        <div class="card mb-4 shadow-sm">
          <div class="card-body d-flex justify-content-between bg-light">
            <div>
              <span class="badge bg-secondary me-2">Status:</span>
              <span id="test-status">Ready</span>
            </div>
            <div>
              <span class="badge bg-secondary me-2">Last Run:</span>
              <span id="last-run-time">Never</span>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/script.js"></script>
</body>
</html> 